<Window x:Class="ProcessVision.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProcessVision" Width="820" Height="610" MinWidth="660" MinHeight="500" WindowStartupLocation="CenterScreen" Background="White" FontFamily="Dubai, Segoe UI" FontSize="14" FlowDirection="LeftToRight" Language="en-US">
 <Grid Margin="18,14,18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="ProcessVision" FontSize="23" FontWeight="Medium"/>
   <TextBlock Text="Last 10 process starts" Foreground="#656565"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Clear" Command="{Binding ClearCommand}"/><Button Content="Export CSV..." Command="{Binding ExportCommand}" Margin="8,0,0,0"/></StackPanel>
   <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxWidth="260" HorizontalAlignment="Left" Width="220" VerticalContentAlignment="Center" AutomationProperties.Name="Search by process name or PID"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <DataGrid ItemsSource="{Binding EntriesView}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#D4D4D4" BorderThickness="1" Background="White" RowHeight="32" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" AutomationProperties.Name="Recent process starts">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" MinWidth="170"/>
     <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="180">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Publisher}"/></Style></DataGridTextColumn.ElementStyle>
      <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Company name from file properties (not a verified digital signature)."/></Style></DataGridTextColumn.HeaderStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65"/>
     <DataGridTextColumn Header="Started" Binding="{Binding TimeLabel}" Width="80"/>
     <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="95"/>
     <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="95"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{Binding EmptyText}" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,10,0,0">
   <TextBox Text="{Binding Selected.ExecutablePath, Mode=OneWay, TargetNullValue='Select a process to see its file path.'}" IsReadOnly="True" Background="#FAFAFA" Padding="7,3" AutomationProperties.Name="Executable path"/>
   <TextBlock Text="{Binding Notice}" Foreground="#8A4800" TextWrapping="Wrap" Margin="0,3,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="4" Margin="0,8,0,0">
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Foreground="#666666"/><TextBlock Text="{Binding Status}" FontWeight="Medium"/></DockPanel>
   <TextBlock Text="{Binding StatusDetail}" Foreground="#666666" TextWrapping="Wrap" FontSize="12"/>
   <Button Content="Enable full monitoring..." Command="{Binding ElevateCommand}" Visibility="{Binding ElevateVisibility}" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="Restart as administrator to receive process-start events."/>
   <TextBlock Text="Startup = currently running processes. Saved entries may have exited." Foreground="#777777" FontSize="12" Margin="0,5,0,0"/>
  </StackPanel>
 </Grid>
</Window>
